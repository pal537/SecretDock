# SecretDock configuration. Copy to .env and fill in. NEVER commit .env.
# cp .env.example .env

# REQUIRED: web login username
SECRETDOCK_USER=admin
# REQUIRED: web login password
SECRETDOCK_PASSWORD=change-me-to-a-strong-password

# OPTIONAL: base64-encoded 32-byte master key for encrypting all stored secrets.
# Leave empty to auto-generate on first start (saved to /data/.master_key).
# Generate one manually: docker run --rm secretdock:latest /secretdock genkey
SECRETDOCK_MASTER_KEY=
